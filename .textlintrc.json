{
  "filters": {
    "allowlist": {
      "allow": [
        "/\\s>\\s/",
        "/リファラー/",
        "/エントリー/",
        "/エントリ/",
        "/(?<!プ)レイヤー/",
        "/(?<!プレ)レイヤ(?!ー)/",
        "/ローダー/",
        "/スクロール/",
        "/ロールバック/",
        "/の分担/",
        "/[.。]\\s*「/u"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 1000
      },
      "no-exclamation-question-mark": false
    },
    "preset-jtf-style": {
      "3.1.1.全角文字と半角文字の間": false,
      "4.3.1.丸かっこ（）": false
    },
    "no-dead-link": {
      "ignoreRedirects": true,
      "preferGET": [
        "https://www.npmjs.com"
      ]
    },
    "ja-space-around-code": {
      "before": true,
      "after": true
    }
  }
}
