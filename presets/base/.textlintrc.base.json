{
  "filters": {
    "allowlist": {
      "allow": [
        "/\\s>\\s/",
        "/リファラー/",
        "/エントリー/",
        "/エントリ/",
        "/(?<!プ)レイヤー/",
        "/(?<!プレ)レイヤ(?!ー)/",
        "/ローダー/",
        "/スクロール/",
        "/ロールバック/",
        "/の分担/",
        "/[.。]\\s*「/u"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": true,
    "preset-jtf-style": {
      "3.1.1.全角文字と半角文字の間": false,
      "4.3.1.丸かっこ（）": false,
      "4.2.7.コロン(：)": false,
      "4.2.8.セミコロン(；)": false
    },
    "prh": {
      "rulePaths": []
    },
    "no-dead-link": {
      "ignoreRedirects": true
    }
  }
}
